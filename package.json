{
  "name": "trackccu",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Roblox statistics on GitHub Pages",
  "scripts": {
    "test": "node --test scripts/test/*.test.mjs debug/messages.test.mjs scripts/bgsi-alerts/test/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o utility.css --minify",
    "build": "node scripts/assemble.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
